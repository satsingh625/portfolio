# ---- GitHub activity integration ----
# Public username used by the /api/github route + GitHubActivity section
NEXT_PUBLIC_GITHUB_USERNAME=your-github-username
# Optional: a fine-grained PAT with public repo read scope raises rate limits
GITHUB_TOKEN=

# ---- Contact form (optional email delivery) ----
# If unset, the contact route logs submissions instead of sending mail.
CONTACT_TO_EMAIL=you@example.com
RESEND_API_KEY=

# ---- Site metadata ----
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
